# /etc/xpark-ai-perf/config.env
#
# Environment overrides for the xpark-ai-perf systemd service.
# All values are optional; the binary has sensible defaults.
#
# Apply changes with: sudo systemctl restart xpark-ai-perf

# Listen port (default: 3000)
# XPARK_AI_PERF_PORT=3000

# Bind address (default: 0.0.0.0 — all interfaces)
# XPARK_AI_PERF_BIND=0.0.0.0

# Metrics polling interval in milliseconds (default: 1000)
# XPARK_AI_PERF_POLL_INTERVAL=1000

# Log level: error, warn, info, debug, trace (default: info)
# RUST_LOG=info
